# Rendered by the coturn Ansible role. Do not edit by hand.

listening-port={{ coturn_listening_port }}
{% if coturn_tls_enabled %}
tls-listening-port={{ coturn_tls_listening_port }}
{% else %}
no-tls
no-dtls
{% endif %}

external-ip={{ coturn_external_ip }}

min-port={{ coturn_min_port }}
max-port={{ coturn_max_port }}

fingerprint
lt-cred-mech

user={{ coturn_user_name }}:{{ coturn_user_password }}

server-name={{ coturn_server_name }}
realm={{ coturn_realm }}

total-quota={{ coturn_total_quota }}
stale-nonce={{ coturn_stale_nonce }}

{% if coturn_tls_enabled %}
cert={{ coturn_tls_cert_path }}
pkey={{ coturn_tls_pkey_path }}
cipher-list="ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-SHA384"
{% endif %}

{% if coturn_no_stdout_log %}
no-stdout-log
{% endif %}

{{ coturn_additional_config }}
